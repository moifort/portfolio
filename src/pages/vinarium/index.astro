---
import Landing from '../../components/vinarium/Landing.astro'
import { site } from '../../data/site'
import Base from '../../layouts/Base.astro'

const alternates = [
  { hreflang: 'en', href: `${site.domain}/vinarium` },
  { hreflang: 'fr', href: `${site.domain}/vinarium/fr` },
  { hreflang: 'x-default', href: `${site.domain}/vinarium` },
]
---

<Base
  title="Vinarium · Your cellar, understood."
  description="A native iOS wine cellar app. Photograph a label, the AI fills everything and estimates the price. Physical cellar map, live value, drink windows, household sharing."
  theme="vinarium"
  lang="en"
  alternates={alternates}
>
  <script slot="head" is:inline>
    // The landing has no language switcher: English is the default and browsers
    // that ask for French get the French page. Runs before paint so there is no
    // flash of the wrong language, and replaces the entry so Back still works.
    ;(function () {
      var preferred = (navigator.languages && navigator.languages[0]) || navigator.language || ''
      if (/^fr\b/i.test(preferred)) {
        location.replace('/vinarium/fr' + location.search + location.hash)
      }
    })()
  </script>
  <Landing lang="en" />
</Base>
