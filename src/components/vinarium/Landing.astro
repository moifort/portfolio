---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import homeIcon from '../../assets/vinarium/home-icon.png'
import wineDetailDark from '../../assets/vinarium/wine-detail-dark.png'
import locationMap from '../../assets/vinarium/location-map.png'
import siriIcon from '../../assets/vinarium/siri-icon.png'
import appIcon from '../../assets/vinarium/app-icon.png'
import cellarShot from '../../assets/vinarium/cellar-dark.png'
import heroArt from '../../assets/vinarium/art/hero.jpg'
import storyArt from '../../assets/vinarium/art/story.jpg'
import journalDarkShot from '../../assets/vinarium/journal-dark.png'
import journalShot from '../../assets/vinarium/journal.png'
import widgetCave from '../../assets/vinarium/widget-en-cave.png'
import widgetJournal from '../../assets/vinarium/widget-journal.png'
import widgetReady from '../../assets/vinarium/widget-pret-a-deguster.png'
import widgetValue from '../../assets/vinarium/widget-valeur.png'
import wineDetailShot from '../../assets/vinarium/wine-detail.png'
import wineListShot from '../../assets/vinarium/wine-list.png'
import { cellarBrandCount, cellarPresets } from '../../data/vinarium-cellars'
import { appStoreUrl, copy } from '../../data/vinarium-copy'
import AppStoreBadge from '../AppStoreBadge.astro'
import IPhoneFrame from '../IPhoneFrame.astro'
import Reveal from '../Reveal.astro'
import SiteFooter from '../SiteFooter.astro'

interface Props {
  lang: 'en' | 'fr'
}

const { lang } = Astro.props
const c = copy[lang]

/* Counts come from the catalogue itself: the copy must not go stale when the
   app adds a model. */
const cellarsLede = c.cellars.lede
  .replace('{models}', String(cellarPresets.length))
  .replace('{brands}', String(cellarBrandCount))


/* The bento geometry is traced from the iOS keynote slide: 15 columns by 12
   rows, each tile given as [column, span, row, span]. Read left to right, top
   to bottom, the sixteen tiles tile the rectangle exactly. */
/* The six beverage types the app recognises, in its own declaration order.
   Each glyph redraws the SF Symbol the app uses, since Apple licenses that set
   for Apple platforms only. Tones follow the app's displayColor, lightened
   where the original would sink into the dark tile.

   One deliberate departure: the app marks cider with "applelogo". Showing
   Apple's mark as a cider icon on a public page is not ours to do, so this is
   an apple, the fruit. */
const beverageTypes = [
  {
    key: 'wine' as const,
    tone: '#c0424a',
    paths: [
      'M7.6 3.2h8.8c.3 0 .5.2.5.5 0 4.4-1.9 7.3-4.9 7.3s-4.9-2.9-4.9-7.3c0-.3.2-.5.5-.5Z',
      'M12 11v9.2',
      'M8.7 20.2h6.6',
    ],
  },
  {
    key: 'spirit' as const,
    tone: '#d08a45',
    paths: [
      'M12 2.8c3.2 3 5.6 5.6 5.6 9.3a5.6 5.6 0 0 1-11.2 0c0-1.7.5-3.1 1.5-4.4.3 1.4 1 2.3 2 2.6-.2-3 .8-5.2 2.1-7.5Z',
    ],
  },
  {
    key: 'beer' as const,
    tone: '#edb83b',
    paths: [
      'M4.8 6.4h11v11a2.6 2.6 0 0 1-2.6 2.6H7.4a2.6 2.6 0 0 1-2.6-2.6Z',
      'M15.8 9.2h1.8a2.6 2.6 0 0 1 0 5.2h-1.8',
    ],
  },
  {
    key: 'sake' as const,
    tone: '#d9d9c7',
    paths: [
      'M5.6 5.6h9.2v6.1a4.6 4.6 0 0 1-9.2 0Z',
      'M14.8 7.3h1.5a2.3 2.3 0 0 1 0 4.6h-1.5',
      'M3.5 17.6h14.4',
    ],
  },
  {
    key: 'cider' as const,
    tone: '#9ebf38',
    paths: [
      'M12 8.4c1.4-1.2 3.1-1.4 4.4-.5 1.6 1.1 2 3.6 1 6.1-.9 2.3-2.5 4-3.9 3.9-.7 0-1-.3-1.5-.3s-.8.3-1.5.3c-1.4.1-3-1.6-3.9-3.9-1-2.5-.6-5 1-6.1 1.3-.9 3-.7 4.4.5Z',
      'M12 8.4V5.6',
      'M12 5.6c1.6-.4 2.6-1.3 2.9-2.6-1.5 0-2.6.9-2.9 2.6Z',
    ],
  },
  {
    key: 'other' as const,
    tone: '#9a9aa0',
    paths: [
      'M12 3.3a8.7 8.7 0 1 1 0 17.4 8.7 8.7 0 0 1 0-17.4Z',
      'M9.9 9.5a2.2 2.2 0 0 1 4.3.5c0 1.5-2.1 1.7-2.1 3.2',
      'M12 16.6h.01',
    ],
  },
]


const bentoShare = 0
const bentoDetail = 7
const bentoTypes = 5
const bentoPrice = 15
const bentoMap = 2
const bentoFav = 3
const bentoContact = 12
const bentoStars = 11
const bentoHero = 8
const bentoSiri = 9
const bentoTiles: [number, number, number, number][] = [
  [1, 3, 1, 4],
  [4, 2, 1, 4],
  [6, 3, 1, 4],
  [9, 2, 1, 4],
  [11, 2, 1, 4],
  [13, 3, 1, 7],
  [1, 2, 5, 3],
  [3, 3, 5, 8],
  [6, 5, 5, 4],
  [11, 2, 5, 4],
  [1, 2, 8, 2],
  [13, 3, 8, 2],
  [6, 3, 9, 4],
  [9, 4, 9, 4],
  [1, 2, 10, 3],
  [13, 3, 10, 3],
]

const widgets = [
  { src: widgetValue, alt: lang === 'fr' ? 'Widget valeur de la cave' : 'Cellar value widget' },
  { src: widgetCave, alt: lang === 'fr' ? 'Widget bouteilles en cave' : 'Bottles in cellar widget' },
  { src: widgetReady, alt: lang === 'fr' ? 'Widget prêt à déguster' : 'Ready to drink widget' },
  { src: widgetJournal, alt: lang === 'fr' ? 'Widget journal' : 'Journal widget' },
]
---

<!-- Pill nav -->
<nav class="vn-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
  <a class="vn-nav__brand" href="#top">
    <Image src={appIcon} alt="" width={72} height={72} />
    <span>Vinarium</span>
  </a>
  <div class="vn-nav__links">
    <a href="#scan">{c.nav.scan}</a>
    <a href="#cellars">{c.nav.cellars}</a>
    <a href="#pricing">{c.nav.pricing}</a>
  </div>
  <a class="vn-nav__cta" href={appStoreUrl} rel="noopener">
    <span class="vn-appstore" aria-hidden="true"><Icon name="simple-icons:appstore" /></span>
    {c.nav.appStore}
  </a>
</nav>

<!-- Hero -->
<header class="vn-hero" id="top">
  <Image
    class="vn-hero__bg"
    src={heroArt}
    alt=""
    widths={[768, 1280, 1920, 3168]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />
  <div class="container vn-hero__inner">
    <div class="vn-hero__text">
      <Reveal delay={0.05}>
        <h1 class="vn-display">
          {c.hero.title.split('\n').map((line, i) => (i === 0 ? line : [<br />, line]))}
        </h1>
      </Reveal>
      <Reveal delay={0.1}><p class="lede vn-hero__lede">{c.hero.lede}</p></Reveal>
      <Reveal delay={0.15}>
        <p class="vn-hero__actions">
          <AppStoreBadge href={appStoreUrl} lang={lang} />
        </p>
      </Reveal>
    </div>
    <Reveal delay={0.15} class="vn-hero__phone">
      <IPhoneFrame>
        <video
          class="vn-hero__video"
          poster="/vinarium/demo-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label={c.alts.dashboard}
        >
          <source src="/vinarium/demo.webm" type="video/webm" />
          <source src="/vinarium/demo.mp4" type="video/mp4" />
        </video>
      </IPhoneFrame>
    </Reveal>
  </div>
</header>

<!-- Compatible cellars -->
<section class="section" id="cellars">
  <div class="container vn-cellars__inner">
    <div class="vn-cellars__text">
      <Reveal>
        <h2 class="vn-headline vn-headline--icon">
          {/* The app marks each cellar row with SF Symbols "cabinet". Apple only
              licenses that artwork for Apple platforms, so this redraws the same
              two-door cabinet in the stroke style of the site's other icons. */}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M12 3v18M9.5 9.5v3M14.5 9.5v3"></path>
          </svg>
          {c.cellars.title}
        </h2>
      </Reveal>
      <Reveal delay={0.05}><p class="lede vn-finder__lede">{cellarsLede}</p></Reveal>
      <Reveal delay={0.1} class="vn-finder">
      <div class="vn-finder__panel">
        <label class="vn-finder__field">
          <Icon name="lucide:search" aria-hidden="true" />
          <input
            type="search"
            data-cellar-search
            placeholder={c.cellars.placeholder}
            aria-label={c.cellars.searchLabel}
            aria-controls="vn-cellar-list"
          />
        </label>
        <p class="vn-finder__count">
          <span data-cellar-count>{cellarPresets.length}</span>{' '}{c.cellars.countLabel}
        </p>
        <div class="vn-finder__results">
          <ul class="vn-finder__list" id="vn-cellar-list" data-cellar-list>
          {
            cellarPresets.map((preset) => (
              <li class="vn-finder__item" data-cellar-item data-haystack={`${preset.brand} ${preset.model}`.toLowerCase()}>
                <span class="vn-finder__brand">{preset.brand}</span>
                <span class="vn-finder__model">{preset.model}</span>
                <span class="vn-finder__spec">
                  {preset.bottles} {c.cellars.bottles} · {preset.zones}{' '}
                  {preset.zones > 1 ? c.cellars.zones : c.cellars.zone}
                </span>
              </li>
            ))
          }
          </ul>
          <p class="vn-finder__empty" data-cellar-empty hidden>{c.cellars.empty}</p>
        </div>
        </div>
      </Reveal>
    </div>
    <Reveal delay={0.15} class="vn-cellars__phone">
      <IPhoneFrame>
        <div class="vn-swap" data-swap>
          <Image class="vn-swap__shot" src={cellarShot} alt={c.alts.cellar} widths={[320, 480, 720]} sizes="(max-width: 900px) 76vw, 340px" data-swap-shot />
          <Image class="vn-swap__shot" src={journalDarkShot} alt={c.alts.journal} widths={[320, 480, 720]} sizes="(max-width: 900px) 76vw, 340px" data-swap-shot />
        </div>
      </IPhoneFrame>
    </Reveal>
  </div>
</section>

<!-- How it works -->
<section class="section vn-how" id="scan">
  <div class="container">
    <div class="vn-bento" data-bento>
      {
        bentoTiles.map(([col, colSpan, row, rowSpan], i) => (
          <article
            class:list={[
              'vn-bento__tile',
              i === bentoHero && 'vn-bento__tile--hero',
              (i === bentoTypes ||
                i === bentoPrice ||
                i === bentoSiri ||
                i === bentoFav ||
                i === bentoContact ||
                i === bentoStars ||
                i === bentoShare) &&
                'vn-bento__tile--art',
              i === bentoMap && 'vn-bento__tile--fill',
              i === bentoDetail && 'vn-bento__tile--head',
            ]}
            style={`grid-area: ${row} / ${col} / span ${rowSpan} / span ${colSpan}`}
          >
            {i === bentoHero && (
              <>
                <Image src={appIcon} alt="" width={192} height={192} />
                <p>Vinarium</p>
              </>
            )}
            {i === bentoMap && (
              <>
                <Image class="vn-map" src={locationMap} alt="" width={1092} height={607} />
                <p class="vn-bento__label">{c.bento.location}</p>
              </>
            )}
            {i === bentoFav && (
              <>
                {/* SF Symbols "heart.fill", redrawn: Apple licenses that set for
                    Apple platforms only. */}
                <svg class="vn-heart" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z" />
                </svg>
                <p class="vn-bento__label">{c.bento.favorites}</p>
              </>
            )}
            {i === bentoContact && (
              <>
                <span class="vn-people" aria-hidden="true">
                  {[
                    ['\u{1F9D4}', '#8c2f3a'],
                    ['\u{1F469}', '#c0424a'],
                    ['\u{1F9D2}', '#d99a2b'],
                  ].map(([face, tone]) => (
                    <span class="vn-avatar" style={`--tone: ${tone}`}>{face}</span>
                  ))}
                  <span class="vn-avatar vn-avatar--more">+2</span>
                </span>
                <p class="vn-bento__label">{c.bento.contacts}</p>
              </>
            )}
            {i === bentoDetail && (
              <>
                <p class="vn-bento__label">{c.bento.detail}</p>
                <IPhoneFrame src={wineDetailDark} alt="" class="vn-bento__phone" />
              </>
            )}
            {i === bentoPrice && (
              <>
                <span class="vn-price" aria-hidden="true">
                  <span class="vn-price__value">142 €</span>
                  <span class="vn-price__note">{c.bento.priceNote}</span>
                </span>
                <p class="vn-bento__label">{c.bento.price}</p>
              </>
            )}
            {i === bentoTypes && (
              <>
                <ul class="vn-types">
                  {beverageTypes.map((t) => (
                    <li style={`--tone: ${t.tone}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        {t.paths.map((d) => (
                          <path d={d} />
                        ))}
                      </svg>
                      {c.bento.types[t.key]}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {i === bentoShare && (
              <>
                <Image class="vn-glyph" src={homeIcon} alt="" width={230} height={230} />
                <p class="vn-bento__label">{c.bento.share}</p>
              </>
            )}
            {i === bentoStars && (
              <>
                <span class="vn-stars" aria-hidden="true">
                  {[0, 1, 2, 3, 4].map(() => (
                    <svg viewBox="0 0 24 24">
                      <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                  ))}
                </span>
                <p class="vn-bento__label">{c.bento.rating}</p>
              </>
            )}
            {i === bentoSiri && (
              <>
                <Image class="vn-siri" src={siriIcon} alt="" width={608} height={608} />
                <p class="vn-bento__label">{c.bento.ai}</p>
              </>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Story -->
<section class="vn-story">
  <Image
    class="vn-story__bg"
    src={storyArt}
    alt=""
    widths={[768, 1280, 1920, 2752]}
    sizes="100vw"
    aria-hidden="true"
  />
  <div class="container vn-story__inner">
    <div class="vn-story__text">
      <Reveal><p class="vn-eyebrow">{c.story.eyebrow}</p></Reveal>
      <Reveal delay={0.05}><h2 class="vn-headline">{c.story.title}</h2></Reveal>
      <Reveal delay={0.1}><p class="vn-story__body">{c.story.body}</p></Reveal>
      <Reveal delay={0.15}><p class="vn-story__body">{c.story.sharing}</p></Reveal>
    </div>
    <Reveal delay={0.1} class="vn-story__badge-wrap">
      <a class="vn-price-badge" href={appStoreUrl} rel="noopener">
        <span class="vn-price-badge__label">{c.story.badgeLabel}</span>
        <span class="vn-price-badge__value">{c.story.badge}</span>
      </a>
    </Reveal>
  </div>
</section>

<!-- Features -->
<section class="section" id="features">
  <svg class="vn-line" viewBox="0 0 640 220" fill="none" aria-hidden="true">
    <path
      d="M628 14 C 460 140, 300 -20, 240 100 C 210 160, 320 200, 270 158 C 220 116, 120 180, 14 204"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
  <div class="container">
    <Reveal><h2 class="vn-headline">{c.features.title}</h2></Reveal>
    <Reveal delay={0.05}><p class="lede vn-features__lede">{c.features.lede}</p></Reveal>
    <div class="vn-features">
      <Reveal group class="vn-features__grid">
        {
          c.features.items.map((item) => (
            <article class="vn-card">
              <h3 class="vn-card__title">{item.title}</h3>
              <p class="vn-card__body">{item.body}</p>
            </article>
          ))
        }
      </Reveal>
      <Reveal group class="vn-features__phones">
        <IPhoneFrame src={wineListShot} alt={c.alts.wineList} class="vn-features__phone" />
        <IPhoneFrame src={journalShot} alt={c.alts.journal} class="vn-features__phone" />
        <IPhoneFrame src={wineDetailShot} alt={c.alts.wineDetail} class="vn-features__phone" />
      </Reveal>
    </div>
    <Reveal><p class="vn-caption">{c.features.widgetsLabel}</p></Reveal>
    <Reveal group class="vn-widgets">
      {
        widgets.map((w) => (
          <figure class="vn-widgets__item">
            <Image src={w.src} alt={w.alt} widths={[320, 480, 640]} sizes="(max-width: 768px) 44vw, 280px" />
          </figure>
        ))
      }
    </Reveal>
  </div>
</section>

<!-- Pricing -->
<section class="section vn-pricing" id="pricing">
  <div class="container--narrow">
    <Reveal><p class="vn-eyebrow">{c.pricing.eyebrow}</p></Reveal>
    <Reveal delay={0.05}><h2 class="vn-headline">{c.pricing.title}</h2></Reveal>
    <Reveal group class="vn-pricing__cards">
      <article class="vn-card vn-pricing__card">
        <h3 class="vn-card__title">{c.pricing.free.name}</h3>
        <p class="vn-pricing__price">{c.pricing.free.price}</p>
        <ul>
          {c.pricing.free.lines.map((line) => <li>{line}</li>)}
        </ul>
      </article>
      <article class="vn-card vn-pricing__card vn-pricing__card--premium">
        <h3 class="vn-card__title">{c.pricing.premium.name}</h3>
        <p class="vn-pricing__price">{c.pricing.premium.price}</p>
        <ul>
          {c.pricing.premium.lines.map((line) => <li>{line}</li>)}
        </ul>
        <p class="vn-pricing__note">{c.pricing.premium.note}</p>
      </article>
    </Reveal>
    <Reveal class="vn-pricing__cta-wrap">
      <a class="btn vn-btn-gold" href={appStoreUrl} rel="noopener">
        <span class="vn-appstore" aria-hidden="true"><Icon name="simple-icons:appstore" /></span>
        {c.pricing.cta}
      </a>
    </Reveal>
  </div>
</section>

<div class="container vn-tagline">
  <p>{c.footer.tagline} <a href="/">{c.footer.backLink} →</a></p>
</div>

<SiteFooter backLink />

<style>
  /* ---------- rigakvest-flavoured type ---------- */
  .vn-eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .vn-display {
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-top: 1rem;
  }

  .vn-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .vn-headline--icon {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .vn-headline--icon svg {
    flex: none;
    width: 0.85em;
    height: 0.85em;
    color: var(--accent);
    stroke-width: 1.5;
  }

  .vn-caption {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-top: 2rem;
    text-align: center;
  }

  .vn-btn-gold {
    background: var(--accent);
    color: #181114;
  }

  .vn-btn-gold:hover {
    box-shadow: 0 10px 30px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  /* ---------- Hero demo video ---------- */
  .vn-hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The demo is a real iPhone 15 Pro screen recording: it already carries the
     status bar laid out around the physical island, so the frame's fake island
     would double it. */
  :global(.vn-hero__phone) :global(.iphone__island) {
    display: none;
  }

  /* ---------- Signature connector lines ---------- */
  .vn-line {
    display: block;
    width: min(40rem, 86vw);
    height: auto;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 6vh, 4rem);
    margin-top: calc(var(--section-gap) * -0.55);
    color: var(--accent);
    opacity: 0.75;
    pointer-events: none;
  }

  /* ---------- Pill nav ---------- */
  .vn-nav {
    position: fixed;
    top: 1rem;
    left: 50%;
    translate: -50% 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.5rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .vn-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9375rem;
    font-weight: 650;
    text-decoration: none;
    color: var(--text);
  }

  .vn-nav__brand img {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
  }

  .vn-nav__links {
    display: flex;
    gap: 1.25rem;
  }

  .vn-nav__links a {
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
    color: var(--text);
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .vn-nav__links a:hover {
    opacity: 1;
  }

  .vn-nav__cta {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    gap: 0.45rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    background: var(--accent);
    color: #181114;
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    transition: transform 0.25s var(--ease-out);
  }

  .vn-nav__cta:hover {
    transform: translateY(-1px);
  }

  /* Official App Store mark: the monochrome glyph on Apple's blue tile. */
  .vn-appstore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.15em;
    height: 1.15em;
    padding: 0.16em;
    border-radius: 0.26em;
    background: linear-gradient(180deg, #2ad0ff 0%, #0a84ff 55%, #0060ff 100%);
    vertical-align: middle;
  }

  .vn-appstore svg {
    width: 100%;
    height: 100%;
    color: #fff;
  }

  /* ---------- Hero ---------- */
  .vn-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(7rem, 16vh, 10rem);
    padding-bottom: clamp(3rem, 8vh, 6rem);
    min-height: 92svh;
    display: flex;
    align-items: center;
  }

  .vn-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .vn-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 30%, transparent),
      color-mix(in srgb, var(--bg) 55%, transparent) 55%,
      var(--bg)
    );
  }

  .vn-hero__inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 3rem;
  }

  .vn-hero__lede {
    color: color-mix(in srgb, var(--text) 82%, transparent);
    margin-top: 1.25rem;
    max-width: 30rem;
  }

  .vn-hero__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }

  :global(.vn-hero__phone) {
    justify-self: center;
  }

  /* ---------- Compatible cellar finder ---------- */
  :global(.vn-finder__lede) {
    margin-top: 1rem;
  }

  #cellars {
    padding-bottom: calc(var(--section-gap) * 0.35);
  }

  .vn-cellars__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  :global(.vn-cellars__phone) {
    justify-self: center;
  }

  :global(.vn-finder) {
    margin-top: 2rem;
  }

  /* Screens stack on top of one another so the frame keeps one size while the
     images cross-fade. */
  .vn-swap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .vn-swap__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vn-finder__panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1.5rem;
  }

  .vn-finder__field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }

  .vn-finder__field:focus-within {
    border-color: var(--accent);
    color: var(--accent);
  }

  .vn-finder__field svg {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
  }

  .vn-finder__field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
  }

  .vn-finder__field input:focus {
    outline: none;
  }

  .vn-finder__field input::-webkit-search-cancel-button {
    filter: invert(1);
    opacity: 0.5;
  }

  .vn-finder__count {
    margin: 1rem 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 550;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .vn-finder__count span {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  /* Fixed height, so filtering down to one result does not collapse the panel
     and shove the rest of the section around. */
  .vn-finder__results {
    position: relative;
    height: 22rem;
  }

  /* The whole catalogue ships in the HTML, so the list scrolls rather than
     stretching the page to 148 rows. */
  .vn-finder__list {
    height: 100%;
    overflow-y: auto;
    margin: 0;
    padding: 0;
    list-style: none;
    overscroll-behavior: contain;
  }

  .vn-finder__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    padding: 0.6rem 0.2rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .vn-finder__item[hidden] {
    display: none;
  }

  /* No rule under the last row. The DOM last covers the unfiltered list; the
     script tags the last *visible* row once a search hides part of it. */
  .vn-finder__item:last-child,
  .vn-finder__item[data-last] {
    border-bottom: 0;
  }

  .vn-finder__brand {
    grid-column: 1;
    font-weight: 650;
  }

  .vn-finder__model {
    grid-column: 1;
    grid-row: 2;
    color: var(--muted);
  }

  .vn-finder__spec {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .vn-finder__empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .vn-finder__empty[hidden] {
    display: none;
  }

  .vn-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 2rem;
  }

  .vn-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .vn-card__body {
    color: var(--muted);
    font-size: 0.9875rem;
    line-height: 1.6;
  }

  /* ---------- Bento, iOS keynote grid ---------- */
  .vn-how {
    padding-top: 0;
  }

  .vn-bento {
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    grid-template-rows: repeat(12, 1fr);
    /* Locks the row-to-column ratio of the original slide at any width. */
    aspect-ratio: 930 / 517;
    gap: 0.5rem;
  }

  .vn-bento__tile {
    border-radius: 0.9rem;
    background: var(--card);
  }

  /* The centre tile plays the part the iOS wordmark plays on the slide. */
  .vn-bento__tile--hero {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    background: radial-gradient(120% 120% at 30% 10%, #3a1f2b 0%, var(--card) 70%);
  }

  .vn-bento__tile--hero img {
    width: clamp(3.5rem, 7vw, 5.5rem);
    height: auto;
    border-radius: 22%;
  }

  .vn-bento__tile--hero p {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Artwork centred in the free space, caption underneath: the caption keeps
     the same size on every tile, as on the slide. */
  .vn-bento__tile--art {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
  }

  /* auto margins let the artwork claim the free space and centre in it, which
     pins the caption to the bottom edge whatever the tile height. */
  .vn-bento__tile--art > :first-child {
    margin: auto;
  }

  .vn-bento__label {
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--text);
  }

  .vn-siri {
    width: min(88%, 5.5rem);
    height: auto;
  }

  .vn-heart {
    width: min(60%, 3.4rem);
    height: auto;
    color: #ff3b30;
  }

  .vn-heart path {
    fill: currentColor;
  }

  .vn-people {
    display: flex;
  }

  /* Overlapping discs, the way the app shows a shared cellar's members. The
     ring is the tile colour so they read as a stack rather than a row. */
  .vn-avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 2px solid var(--card);
    background: var(--tone, #8c2f3a);
    font-size: 1.1875rem;
    line-height: 1;
    font-weight: 650;
    color: #fff;
  }

  .vn-avatar + .vn-avatar {
    margin-left: -0.85rem;
  }

  .vn-glyph {
    width: min(52%, 4rem);
    height: auto;
  }

  /* Caption on top, device below and deliberately taller than the space left,
     so it runs off the bottom edge the way the keynote slide crops a phone. */
  .vn-bento__tile--head {
    position: relative;
    overflow: hidden;
    /* No padding on the tile itself: the caption and the device each carry
       their own inset, so the device can be positioned freely. */
    padding: 0;
    /* Makes the tile a query container so the frame can size itself against it
       in a real length. */
    container-type: inline-size;
  }

  .vn-bento__tile--head .vn-bento__label {
    padding: 1rem 0.75rem 0;
  }

  /* --iphone-w feeds calc() for the bezel and the corner radii, so it has to be
     a length: a percentage would resolve against the parent and warp the frame.
     Doubled class so it outranks .iphone's own width. */
  :global(.iphone.vn-bento__phone) {
    --iphone-w: 87cqw;
    position: absolute;
    top: 5rem;
    left: 50%;
    translate: -50% 0;
  }

  /* The screenshot carries its own status bar and island. */
  :global(.vn-bento__phone) :global(.iphone__island) {
    display: none;
  }

  .vn-price {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
  }

  .vn-price__value {
    color: var(--accent);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .vn-price__note {
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .vn-types {
    display: grid;
    gap: 0.55rem;
    width: 100%;
    margin: 0;
    padding: 0 0.25rem;
    list-style: none;
  }

  .vn-types li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    font-weight: 550;
  }

  /* SF Symbols sit lighter than the site's other icons, hence the thinner
     stroke and the round joins. */
  .vn-types svg {
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: var(--tone);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vn-stars {
    display: flex;
    gap: 0.15rem;
  }

  .vn-stars svg {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--accent);
  }

  .vn-stars svg path {
    fill: currentColor;
  }

  .vn-avatar--more {
    background: rgba(246, 239, 231, 0.14);
    font-size: 0.75rem;
  }

  /* Edge to edge artwork: the image covers the tile and the caption rides on
     top of it, over a scrim so it stays readable whatever the image shows. */
  .vn-bento__tile--fill {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 0;
  }

  .vn-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vn-bento__tile--fill .vn-bento__label {
    position: relative;
    padding: 2.5rem 0.75rem 0.9rem;
    background: linear-gradient(to top, rgba(10, 6, 8, 0.85) 35%, transparent);
  }

  /* ---------- How it works ---------- */
  :global(.vn-steps) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .vn-step {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .vn-step__n {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .vn-duo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 4vw, 3rem);
    margin-top: 4rem;
  }

  :global(.vn-duo__arrow) span {
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: var(--accent);
  }

  /* ---------- Story ---------- */
  .vn-story {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(7rem, 20vh, 13rem);
  }

  .vn-story__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .vn-story::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      var(--bg),
      color-mix(in srgb, var(--bg) 35%, transparent) 30%,
      color-mix(in srgb, var(--bg) 35%, transparent) 70%,
      var(--bg)
    );
  }

  .vn-story__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 3rem;
  }

  .vn-story__text {
    max-width: 36rem;
  }

  .vn-story__body {
    color: color-mix(in srgb, var(--text) 85%, transparent);
    margin-top: 1.25rem;
    line-height: 1.65;
  }

  .vn-price-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: clamp(8rem, 14vw, 10.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    text-decoration: none;
    rotate: 8deg;
    transition: rotate 0.35s var(--ease-out), scale 0.35s var(--ease-out);
    background: color-mix(in srgb, var(--bg) 45%, transparent);
    backdrop-filter: blur(4px);
  }

  .vn-price-badge:hover {
    rotate: 0deg;
    scale: 1.04;
  }

  .vn-price-badge__label {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .vn-price-badge__value {
    font-size: 1.6rem;
    font-weight: 650;
  }

  /* ---------- Features ---------- */
  .vn-features__lede {
    margin-top: 1rem;
    max-width: 34rem;
  }

  .vn-features {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
    margin-top: 3rem;
  }

  :global(.vn-features__grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  :global(.vn-features__phones) {
    display: flex;
    gap: 1rem;
  }

  :global(.vn-features__phones) :global(.vn-features__phone) {
    --iphone-w: clamp(150px, 16vw, 200px);
  }

  :global(.vn-features__phones) :global(.vn-features__phone:nth-child(2)) {
    translate: 0 2.5rem;
  }

  :global(.vn-widgets) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .vn-widgets__item img {
    width: 100%;
    height: auto;
    border-radius: 1.4rem;
    border: 1px solid var(--border);
  }

  /* ---------- Pricing ---------- */
  :global(.vn-pricing__cards) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .vn-pricing__card ul {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: grid;
    gap: 0.6rem;
  }

  .vn-pricing__card li {
    color: var(--muted);
    font-size: 0.9375rem;
    padding-left: 1.4rem;
    position: relative;
  }

  .vn-pricing__card li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .vn-pricing__card--premium {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--accent) 6%, var(--card));
  }

  .vn-pricing__price {
    color: var(--accent);
    font-weight: 650;
    font-size: 1.1rem;
  }

  .vn-pricing__note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
    font-style: italic;
  }

  :global(.vn-pricing__cta-wrap) {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  :global(.vn-pricing__cta-wrap) svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* ---------- Tagline ---------- */
  .vn-tagline p {
    color: var(--muted);
    font-size: 0.9375rem;
    text-align: center;
  }

  .vn-tagline a {
    color: var(--text);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .vn-nav__links {
      display: none;
    }

    .vn-duo {
      gap: clamp(0.5rem, 2.5vw, 1.5rem);
    }

    .vn-duo :global(.iphone) {
      --iphone-w: clamp(120px, 36vw, 240px);
    }

    .vn-hero__inner,
    .vn-cellars__inner,
    .vn-features {
      grid-template-columns: 1fr;
    }

    /* The 15-column mosaic is unreadable on a phone: fall back to a plain
       two-column grid and let the tiles take their natural order. */
    .vn-bento {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: none;
      grid-auto-rows: 7rem;
      aspect-ratio: auto;
    }

    .vn-bento__tile {
      grid-area: auto !important;
    }

    :global(.vn-hero__phone) {
      margin-top: 1rem;
    }

    :global(.vn-steps) {
      grid-template-columns: 1fr;
