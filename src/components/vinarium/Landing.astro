    :global(.vn-features__phones) {
      justify-content: center;
      flex-wrap: wrap;
    }

    :global(.vn-features__phones .vn-features__phone) {
      --iphone-w: clamp(96px, 26vw, 200px);
    }

    :global(.vn-widgets) {
      grid-template-columns: repeat(2, 1fr);
    }

    :global(.vn-pricing__cards) {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initBento } from '../../scripts/bento'
  import { initCellarFinder } from '../../scripts/cellar-finder'
  import { gsap, prefersReducedMotion } from '../../scripts/motion'
  import { initScreenSwap } from '../../scripts/screen-swap'

  initBento()
  initCellarFinder()
  initScreenSwap()

  if (prefersReducedMotion()) {
    for (const video of document.querySelectorAll<HTMLVideoElement>('.vn-hero__video')) {
      video.removeAttribute('autoplay')
      video.pause()
    }
  }

  for (const path of document.querySelectorAll<SVGPathElement>('.vn-line path')) {
    const length = path.getTotalLength()
    if (prefersReducedMotion()) continue
    path.style.strokeDasharray = `${length}`
    path.style.strokeDashoffset = `${length}`
    gsap.to(path, {
      strokeDashoffset: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: path.closest('svg'),
        start: 'top 92%',
        end: 'bottom 45%',
        scrub: true,
      },
    })
  }
</script>
