---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import homeIcon from '../../assets/vinarium/home-icon.png'
import wineDetailDark from '../../assets/vinarium/wine-detail-dark.png'
import locationMap from '../../assets/vinarium/location-map.png'
import decanter from '../../assets/vinarium/decanter.png'
import sakeShot from '../../assets/vinarium/sake.png'
import searchShot from '../../assets/vinarium/search-dark.png'
import memoji1 from '../../assets/vinarium/memoji/memoji-1.png'
import memoji2 from '../../assets/vinarium/memoji/memoji-2.png'
import memoji3 from '../../assets/vinarium/memoji/memoji-3.png'
import memoji4 from '../../assets/vinarium/memoji/memoji-4.png'
import siriIcon from '../../assets/vinarium/siri-icon.png'
import appIcon from '../../assets/vinarium/app-icon.png'
import cellarShot from '../../assets/vinarium/cellar-dark.png'
import heroArt from '../../assets/vinarium/art/hero.jpg'
import journalDarkShot from '../../assets/vinarium/journal-dark.png'
import { cellarBrandCount, cellarPresets } from '../../data/vinarium-cellars'
import { appStoreUrl, copy } from '../../data/vinarium-copy'
import AppStoreBadge from '../AppStoreBadge.astro'
import IPhoneFrame from '../IPhoneFrame.astro'
import Reveal from '../Reveal.astro'

interface Props {
  lang: 'en' | 'fr'
}

const { lang } = Astro.props
const c = copy[lang]

/* Counts come from the catalogue itself: the copy must not go stale when the
   app adds a model. */
const cellarsLede = c.cellars.lede
  .replace('{models}', String(cellarPresets.length))
  .replace('{brands}', String(cellarBrandCount))


/* The bento geometry is traced from the iOS keynote slide: 15 columns by 12
   rows, each tile given as [column, span, row, span]. Read left to right, top
   to bottom, the sixteen tiles tile the rectangle exactly. */



/* Laid out on an invisible circle rather than in a row: each bubble sits at a
   fixed angle and radius, sized unevenly so the cluster reads as a household.
   The radius is chosen so neighbours never touch. */
const householdBubbles: { src: ImageMetadata; size: number; x: number; y: number; tone: string }[] = [
  { src: memoji2, size: 2.94, x: -1.76, y: -1.02, tone: '#b32a3c' },
  { src: memoji3, size: 2.45, x: 1.02, y: -1.76, tone: '#e0453f' },
  { src: memoji1, size: 2.66, x: 1.76, y: 1.01, tone: '#8e3fd4' },
  { src: memoji4, size: 2.17, x: -1.01, y: 1.76, tone: '#f0a01e' },
]
/* The dashboard's ready-to-drink list, redrawn rather than screenshotted: at
   tile size the capture would be unreadable, and the rows have to reflow when
   the tile does. Dots reuse the wine-colour palette of the search filters.
   Deliberately longer than the tile is tall: the last row is cut by the bottom
   edge, which is what says the list carries on. */
const readyWines: { name: string; tone: string; year: number }[] = [
  { name: 'Tapada das Gamas', tone: '#c0424a', year: 2026 },
  { name: 'La Gioiosa Valdobbiadene', tone: '#d9e08c', year: 2026 },
  { name: 'Tavel Différent', tone: '#ff6b8c', year: 2026 },
  { name: 'Bailly Lapierre Crémant', tone: '#d9e08c', year: 2027 },
  { name: "Quinta Seara d'Ordens Porto", tone: '#c0424a', year: 2027 },
  { name: 'Domaine Ott Clos Mireille', tone: '#ff6b8c', year: 2028 },
  { name: 'Château Musar Rouge', tone: '#c0424a', year: 2028 },
]

/* An excerpt of the account export, shaped like the app's own JSON file. Short
   lines on purpose: the tile is two columns wide, so anything longer would be
   cut mid-key. The tile clips whatever runs past its edges. */
const exportJson = `{
  "cellar": "Maison",
  "bottles": 214,
  "wines": [
    {
      "name": "Tavel",
      "vintage": 2021,
      "type": "rose",
      "slot": "A5",
      "price": 18.50
    },
    {
      "name": "Musar",
      "vintage": 2016,
      "type": "red",
      "slot": "B2",
      "price": 42.00
    },
    {
      "name": "Bucu",`

/* The bento geometry is traced from the iOS keynote slide: 15 columns by 12
   rows. Naming each cell keeps the content tied to a tile rather than to its
   position in the array, so cells can be merged without renumbering. */
const bentoTiles = [
  { key: 'share', col: 1, colSpan: 3, row: 1, rowSpan: 4 },
  { key: 'export', col: 4, colSpan: 2, row: 1, rowSpan: 4 },
  { key: 'map', col: 6, colSpan: 3, row: 1, rowSpan: 4 },
  { key: 'fav', col: 9, colSpan: 2, row: 1, rowSpan: 4 },
  { key: 'decanter', col: 11, colSpan: 2, row: 1, rowSpan: 4 },
  { key: 'search', col: 13, colSpan: 3, row: 1, rowSpan: 7 },
  { key: 'comments', col: 1, colSpan: 2, row: 5, rowSpan: 3 },
  { key: 'detail', col: 3, colSpan: 3, row: 5, rowSpan: 8 },
  { key: 'hero', col: 6, colSpan: 5, row: 5, rowSpan: 4 },
  { key: 'siri', col: 11, colSpan: 2, row: 5, rowSpan: 4 },
  { key: 'sake', col: 1, colSpan: 2, row: 8, rowSpan: 5 },
  { key: 'stars', col: 13, colSpan: 3, row: 8, rowSpan: 2 },
  { key: 'contact', col: 6, colSpan: 3, row: 9, rowSpan: 4 },
  { key: 'ready', col: 9, colSpan: 4, row: 9, rowSpan: 4 },
  { key: 'price', col: 13, colSpan: 3, row: 10, rowSpan: 3 },
] as const

/* Which layout each tile uses: artwork centred with a caption under it, artwork
   bled to the edges with the caption over it, or caption on top. */
/* One glyph per searchable field, in the order the copy lists them. */
const searchIcons = [
  'lucide:wine',
  'lucide:building-2',
  'lucide:tag',
  'lucide:award',
  'lucide:map',
  'lucide:calendar',
  'lucide:gift',
  'lucide:gift',
  'lucide:user-round-check',
  'lucide:users',
]

/* Filter chips: the three wine colours show a coloured dot, as in the app; the
   rest carry a glyph. Same order as the copy. */
const searchFilters: ({ dot: string } | { icon: string })[] = [
  { dot: '#c0424a' },
  { dot: '#d9e08c' },
  { dot: '#ff6b8c' },
  { icon: 'lucide:heart' },
  { icon: 'lucide:grid-3x3' },
  { icon: 'lucide:check' },
  { icon: 'lucide:gift' },
]

const ART_TILES = new Set(['share', 'export', 'fav', 'comments', 'siri', 'stars', 'contact', 'price', 'ready'])
const FILL_TILES = new Set(['map', 'decanter', 'sake'])
const HEAD_TILES = new Set(['detail', 'search'])
---

<!-- Pill nav -->
<nav class="vn-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
  <a class="vn-nav__brand" href="#top">
    <Image src={appIcon} alt="" width={72} height={72} />
    <span>Vinarium</span>
  </a>
  {/* Same order as the page, so the pill reads as a map of the scroll. */}
  <div class="vn-nav__links">
    <a href="#cellars">{c.nav.cellars}</a>
    <a href="#features">{c.nav.features}</a>
    <a href="#search">{c.nav.search}</a>
    <a href="#pricing">{c.nav.pricing}</a>
  </div>
  <a class="vn-nav__cta" href={appStoreUrl} rel="noopener">
    <span class="vn-appstore" aria-hidden="true"><Icon name="simple-icons:appstore" /></span>
    {c.nav.appStore}
  </a>
</nav>

<!-- Hero -->
<header class="vn-hero" id="top">
  <Image
    class="vn-hero__bg"
    src={heroArt}
    alt=""
    widths={[768, 1280, 1920, 3168]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />
  <div class="container vn-hero__inner">
    <div class="vn-hero__text">
      <Reveal delay={0.05}>
        <h1 class="vn-display">
          {c.hero.title.split('\n').map((line, i) => (i === 0 ? line : [<br />, line]))}
        </h1>
      </Reveal>
      <Reveal delay={0.1}><p class="lede vn-hero__lede">{c.hero.lede}</p></Reveal>
      <Reveal delay={0.15}>
        <p class="vn-hero__actions">
          <AppStoreBadge href={appStoreUrl} lang={lang} />
        </p>
      </Reveal>
    </div>
    <Reveal delay={0.15} class="vn-hero__phone">
      <IPhoneFrame>
        <video
          class="vn-hero__video"
          poster="/vinarium/demo-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label={c.alts.dashboard}
        >
          <source src="/vinarium/demo.webm" type="video/webm" />
          <source src="/vinarium/demo.mp4" type="video/mp4" />
        </video>
      </IPhoneFrame>
    </Reveal>
  </div>
</header>

<!-- Compatible cellars -->
<section class="section" id="cellars">
  <div class="container vn-cellars__inner">
    <div class="vn-cellars__text">
      <Reveal>
        <h2 class="vn-headline vn-headline--icon">
          {/* The app marks each cellar row with SF Symbols "cabinet". Apple only
              licenses that artwork for Apple platforms, so this redraws the same
              two-door cabinet in the stroke style of the site's other icons. */}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M12 3v18M9.5 9.5v3M14.5 9.5v3"></path>
          </svg>
          {c.cellars.title}
        </h2>
      </Reveal>
      <Reveal delay={0.05}><p class="lede vn-finder__lede">{cellarsLede}</p></Reveal>
      <Reveal delay={0.1} class="vn-finder">
      <div class="vn-finder__panel">
        <label class="vn-finder__field">
          <Icon name="lucide:search" aria-hidden="true" />
          <input
            type="search"
            data-cellar-search
            placeholder={c.cellars.placeholder}
            aria-label={c.cellars.searchLabel}
            aria-controls="vn-cellar-list"
          />
        </label>
        <p class="vn-finder__count">
          <span data-cellar-count>{cellarPresets.length}</span>{' '}{c.cellars.countLabel}
        </p>
        <div class="vn-finder__results" data-cellar-results>
          <ul class="vn-finder__list" id="vn-cellar-list" data-cellar-list>
          {
            cellarPresets.map((preset) => (
              <li class="vn-finder__item" data-cellar-item data-haystack={`${preset.brand} ${preset.model}`.toLowerCase()}>
                <span class="vn-finder__brand">{preset.brand}</span>
                <span class="vn-finder__model">{preset.model}</span>
                <span class="vn-finder__spec">
                  {preset.bottles} {c.cellars.bottles} · {preset.zones}{' '}
                  {preset.zones > 1 ? c.cellars.zones : c.cellars.zone}
                </span>
              </li>
            ))
          }
          </ul>
          <p class="vn-finder__empty" data-cellar-empty hidden>{c.cellars.empty}</p>
          {/* Pointer affordance: the list it describes sits right above it, and
              a screen reader reaches that list directly. */}
          <p class="vn-finder__gate" data-cellar-gate aria-hidden="true">{c.cellars.scrollHint}</p>
        </div>
        </div>
      </Reveal>
    </div>
    <Reveal delay={0.15} class="vn-cellars__phone">
      <IPhoneFrame>
        <div class="vn-swap" data-swap>
          <Image class="vn-swap__shot" src={cellarShot} alt={c.alts.cellar} widths={[320, 480, 720]} sizes="(max-width: 900px) 76vw, 340px" data-swap-shot />
          <Image class="vn-swap__shot" src={journalDarkShot} alt={c.alts.journal} widths={[320, 480, 720]} sizes="(max-width: 900px) 76vw, 340px" data-swap-shot />
        </div>
      </IPhoneFrame>
    </Reveal>
  </div>
</section>

<!-- How it works -->
<section class="section vn-how" id="features">
  <div class="container">
    <Reveal>
      <h2 class="vn-headline vn-headline--icon vn-bento__title">
        {/* SF Symbols "square.grid.2x2", redrawn: the mosaic below in glyph
            form, since this section has no single screen to stand for it. */}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7.5" height="7.5" rx="2"></rect>
          <rect x="13.5" y="3" width="7.5" height="7.5" rx="2"></rect>
          <rect x="3" y="13.5" width="7.5" height="7.5" rx="2"></rect>
          <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"></rect>
        </svg>
        {c.bento.title}
      </h2>
    </Reveal>
    <div class="vn-bento" data-bento>
      {
        bentoTiles.map(({ key, col, colSpan, row, rowSpan }) => (
          <article
            class:list={[
              'vn-bento__tile',
              key === 'hero' && 'vn-bento__tile--hero',
              ART_TILES.has(key) && 'vn-bento__tile--art',
              key === 'ready' && 'vn-bento__tile--rows',
              FILL_TILES.has(key) && 'vn-bento__tile--fill',
              HEAD_TILES.has(key) && 'vn-bento__tile--head',
            ]}
            style={`grid-area: ${row} / ${col} / span ${rowSpan} / span ${colSpan}`}
          >
            {key === 'hero' && (
              <>
                <Image src={appIcon} alt="" width={192} height={192} />
                <p>Vinarium</p>
              </>
            )}
            {key === 'map' && (
              <>
                <Image class="vn-map" src={locationMap} alt="" width={1092} height={607} />
                <p class="vn-bento__label">{c.bento.location}</p>
              </>
            )}
            {key === 'fav' && (
              <>
                {/* SF Symbols "heart.fill", redrawn: Apple licenses that set for
                    Apple platforms only. */}
                <svg class="vn-heart" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z" />
                </svg>
                <p class="vn-bento__label">{c.bento.favorites}</p>
              </>
            )}
            {key === 'contact' && (
              <>
                <span class="vn-people" aria-hidden="true">
                  {householdBubbles.map((b) => (
                    <span class="vn-bubble" style={`--size: ${b.size}rem; --x: ${b.x}rem; --y: ${b.y}rem; --tone: ${b.tone}`}>
                      <Image src={b.src} alt="" width={240} height={240} />
                    </span>
                  ))}
                </span>
                <p class="vn-bento__label">{c.bento.contacts}</p>
              </>
            )}
            {key === 'detail' && (
              <>
                <p class="vn-bento__label">{c.bento.detail}</p>
                <IPhoneFrame src={wineDetailDark} alt="" class="vn-bento__phone" />
              </>
            )}
            {key === 'comments' && (
              <>
                {/* SF Symbols "text.quote", redrawn: the quote mark alone, since
                    the tile is too small for its text lines to read. */}
                <svg class="vn-quote" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9.4 5.6c-3.4 1.9-5.6 5-5.6 8.6 0 2.6 1.7 4.4 4 4.4 2.1 0 3.6-1.5 3.6-3.5 0-1.9-1.4-3.3-3.3-3.3-.3 0-.7 0-1 .1.5-1.9 1.8-3.4 3.6-4.4Zm10.8 0c-3.4 1.9-5.6 5-5.6 8.6 0 2.6 1.7 4.4 4 4.4 2.1 0 3.6-1.5 3.6-3.5 0-1.9-1.4-3.3-3.3-3.3-.3 0-.7 0-1 .1.5-1.9 1.8-3.4 3.6-4.4Z" />
                </svg>
                <p class="vn-bento__label">{c.bento.comments}</p>
              </>
            )}
            {key === 'export' && (
              <>
                <pre class="vn-json" aria-hidden="true">{exportJson}</pre>
                <p class="vn-bento__label">{c.bento.dataExport}</p>
              </>
            )}
            {key === 'sake' && (
              <>
                <Image class="vn-map vn-map--sake" src={sakeShot} alt="" widths={[160, 248]} sizes="(max-width: 900px) 45vw, 200px" />
                <p class="vn-bento__label">{c.bento.sake}</p>
              </>
            )}
            {key === 'decanter' && (
              <>
                <Image class="vn-map vn-map--decanter" src={decanter} alt="" widths={[160, 254]} sizes="(max-width: 900px) 45vw, 200px" />
                <p class="vn-bento__label">{c.bento.decanter}</p>
              </>
            )}
            {key === 'price' && (
              <>
                {/* Three identical periods stacked 12 units apart: scrolling by
                    exactly one period lands period 2 where period 1 was, so the
                    loop never seams. */}
                <svg class="vn-trend" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true" data-trend>
                  <g data-trend-scroll>
                    <path
                      class="vn-trend__area"
                      d="M0 54C3.33 54 6.67 47.67 10 48C13.33 48.33 16.67 56.67 20 56C23.33 55.33 26.67 45.33 30 44C33.33 42.67 36.67 49 40 48C43.33 47 46.67 38.33 50 38C53.33 37.67 56.67 46.67 60 46C63.33 45.33 66.67 35 70 34C73.33 33 76.67 39.67 80 40C83.33 40.33 86.67 35.67 90 36C93.33 36.33 96.67 42 100 42C103.33 42 106.67 35.67 110 36C113.33 36.33 116.67 44.67 120 44C123.33 43.33 126.67 33.33 130 32C133.33 30.67 136.67 37 140 36C143.33 35 146.67 26.33 150 26C153.33 25.67 156.67 34.67 160 34C163.33 33.33 166.67 23 170 22C173.33 21 176.67 27.67 180 28C183.33 28.33 186.67 23.67 190 24C193.33 24.33 196.67 30 200 30C203.33 30 206.67 23.67 210 24C213.33 24.33 216.67 32.67 220 32C223.33 31.33 226.67 21.33 230 20C233.33 18.67 236.67 25 240 24C243.33 23 246.67 14.33 250 14C253.33 13.67 256.67 22.67 260 22C263.33 21.33 266.67 11 270 10C273.33 9 276.67 15.67 280 16C283.33 16.33 286.67 11.67 290 12C293.33 12.33 296.67 18 300 18L300 100L0 100Z"
                    />
                    <path
                      class="vn-trend__line"
                      d="M0 54C3.33 54 6.67 47.67 10 48C13.33 48.33 16.67 56.67 20 56C23.33 55.33 26.67 45.33 30 44C33.33 42.67 36.67 49 40 48C43.33 47 46.67 38.33 50 38C53.33 37.67 56.67 46.67 60 46C63.33 45.33 66.67 35 70 34C73.33 33 76.67 39.67 80 40C83.33 40.33 86.67 35.67 90 36C93.33 36.33 96.67 42 100 42C103.33 42 106.67 35.67 110 36C113.33 36.33 116.67 44.67 120 44C123.33 43.33 126.67 33.33 130 32C133.33 30.67 136.67 37 140 36C143.33 35 146.67 26.33 150 26C153.33 25.67 156.67 34.67 160 34C163.33 33.33 166.67 23 170 22C173.33 21 176.67 27.67 180 28C183.33 28.33 186.67 23.67 190 24C193.33 24.33 196.67 30 200 30C203.33 30 206.67 23.67 210 24C213.33 24.33 216.67 32.67 220 32C223.33 31.33 226.67 21.33 230 20C233.33 18.67 236.67 25 240 24C243.33 23 246.67 14.33 250 14C253.33 13.67 256.67 22.67 260 22C263.33 21.33 266.67 11 270 10C273.33 9 276.67 15.67 280 16C283.33 16.33 286.67 11.67 290 12C293.33 12.33 296.67 18 300 18"
                    />
                  </g>
                </svg>
                <span class="vn-price" aria-hidden="true"><span data-trend-count="142">0</span> $</span>
                <p class="vn-bento__label">{c.bento.price}</p>
              </>
            )}
            {key === 'search' && (
              <>
                <p class="vn-bento__label">{c.bento.search}</p>
                <IPhoneFrame src={searchShot} alt="" class="vn-bento__phone vn-bento__phone--corner" />
              </>
            )}
            {key === 'share' && (
              <>
                <Image class="vn-glyph" src={homeIcon} alt="" width={230} height={230} />
                <p class="vn-bento__label">{c.bento.share}</p>
              </>
            )}
            {key === 'stars' && (
              <>
                <span class="vn-stars" aria-hidden="true">
                  {[0, 1, 2, 3, 4].map(() => (
                    <svg viewBox="0 0 24 24">
                      <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                  ))}
                </span>
                <p class="vn-bento__label">{c.bento.rating}</p>
              </>
            )}
            {key === 'siri' && (
              <>
                <Image class="vn-siri" src={siriIcon} alt="" width={608} height={608} />
                <p class="vn-bento__label">{c.bento.ai}</p>
              </>
            )}
            {key === 'ready' && (
              <>
                <p class="vn-bento__label">{c.bento.ready}</p>
                {/* Sample bottles, like the price curve next to it: decorative,
                    so the caption alone carries the meaning. */}
                <ul class="vn-ready" aria-hidden="true">
                  {readyWines.map((wine) => (
                    <li class="vn-ready__row">
                      <span class="vn-ready__dot" style={`--dot: ${wine.tone}`} />
                      <span class="vn-ready__name">{wine.name}</span>
                      <span class="vn-ready__badge">
                        {c.bento.readyBefore.replace('{year}', String(wine.year))}
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Global search -->
<section class="section" id="search">
  <div class="container vn-search__inner">
    <Reveal class="vn-search__head">
      <h2 class="vn-headline vn-headline--icon">
        {/* SF Symbols "magnifyingglass", the app's own search glyph. */}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="10.6" cy="10.6" r="7.1"></circle>
          <path d="M15.8 15.8 21 21"></path>
        </svg>
        {c.search.title}
      </h2>
    </Reveal>
    <Reveal delay={0.1} class="vn-search__phone">
      <IPhoneFrame src={searchShot} alt={c.alts.wineList} />
    </Reveal>
    <div class="vn-search__text">
      <Reveal delay={0.05}>
        <p class="vn-searchbar" data-search-demo={JSON.stringify(c.search.examples)}>
          <Icon name="lucide:search" aria-hidden="true" />
          <span class="vn-searchbar__typed"><span data-search-demo-text></span></span>
          <span class="vn-searchbar__hint">{c.search.placeholder}</span>
        </p>
      </Reveal>
      <Reveal delay={0.1}>
        <ul class="vn-search__fields">
          {
            c.search.fields.map((field, i) => (
              <li>
                <Icon name={searchIcons[i] ?? 'lucide:tag'} aria-hidden="true" />
                {field}
              </li>
            ))
          }
        </ul>
      </Reveal>
      <Reveal delay={0.15}>
        <p class="vn-search__sub">{c.search.filtersLabel}</p>
        <ul class="vn-search__chips">
          {
            c.search.filters.map((filter, i) => {
              const mark = searchFilters[i]
              return (
                <li>
                  {mark && 'dot' in mark ? (
                    <span class="vn-chip__dot" style={`--dot: ${mark.dot}`} aria-hidden="true" />
                  ) : (
                    <Icon name={mark && 'icon' in mark ? mark.icon : 'lucide:tag'} aria-hidden="true" />
                  )}
                  {filter}
                </li>
              )
            })
          }
        </ul>
      </Reveal>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section vn-pricing" id="pricing">
  <div class="container">
    {/* The section deliberately shows no heading: the table's own column heads
        carry it. Kept for the document outline and heading navigation. */}
    <h2 class="vn-sr">{c.nav.pricing}</h2>
    <Reveal delay={0.05}>
      <table class="vn-plans">
        <thead>
          <tr>
            {/* Empty corner: the row headings below name the feature. */}
            <th scope="col"></th>
            <th scope="col">
              <span class="vn-plans__name">{c.pricing.free.name}</span>
              <span class="vn-plans__price">{c.pricing.free.price}</span>
            </th>
            <th scope="col" class="vn-plans__premium">
              <span class="vn-plans__name">{c.pricing.premium.name}</span>
              <span class="vn-plans__price">{c.pricing.premium.monthly}</span>
              <span class="vn-plans__alt">{c.pricing.premium.yearly}</span>
              <span class="vn-plans__options">{c.pricing.premium.trial}</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            c.pricing.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>
                  {row.free === true ? (
                    <>
                      <span class="vn-plans__check" aria-hidden="true">✓</span>
                      <span class="vn-sr">{c.pricing.included}</span>
                    </>
                  ) : (
                    row.free
                  )}
                </td>
                <td class="vn-plans__premium">
                  {row.premium === true ? (
                    <>
                      <span class="vn-plans__check" aria-hidden="true">✓</span>
                      <span class="vn-sr">{c.pricing.included}</span>
                    </>
                  ) : (
                    row.premium
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </Reveal>
    <Reveal delay={0.1}>
      {/* Same sentence as the premium column header, shown only where that
          column is too narrow to hold it. aria-hidden either way: the header
          already says it to a screen reader. */}
      <p class="vn-pricing__options-mobile" aria-hidden="true">{c.pricing.premium.trial}</p>
    </Reveal>
    <Reveal class="vn-pricing__cta-wrap">
      <AppStoreBadge href={appStoreUrl} lang={lang} />
    </Reveal>
  </div>
</section>

<style>
