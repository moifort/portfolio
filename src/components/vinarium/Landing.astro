  }

  .vn-search__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* The heading runs the full width; the mock and the list share the row under
     it. */
  :global(.vn-search__head) {
    grid-column: 1 / -1;
  }

  :global(.vn-search__phone) {
    display: block;
  }

  /* A field rather than a paragraph: the examples type themselves into it. */
  .vn-searchbar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    font-size: 1rem;
  }

  .vn-searchbar svg {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
