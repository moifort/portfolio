  }

  .vn-cellars__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  :global(.vn-cellars__phone) {
    justify-self: end;
  }

  :global(.vn-finder) {
    margin-top: 2rem;
  }

  /* Screens stack on top of one another so the frame keeps one size while the
     images cross-fade. */
  .vn-swap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .vn-swap__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vn-finder__panel {
    background: var(--card);
    border: 1px solid var(--border);
