  }

  .vn-finder__field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }

  .vn-finder__field:focus-within {
    border-color: var(--accent);
    color: var(--accent);
  }

  .vn-finder__field svg {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
  }

  .vn-finder__field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
