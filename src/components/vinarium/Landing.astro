  /* ---------- Bento, iOS keynote grid ---------- */
  .vn-how {
    padding-top: 0;
  }

  .vn-bento__title {
    margin-bottom: 2.5rem;
  }

  .vn-bento {
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    grid-template-rows: repeat(12, 1fr);
    /* Locks the row-to-column ratio of the original slide at any width. */
    aspect-ratio: 930 / 517;
    gap: 0.5rem;
  }

  .vn-bento__tile {
    position: relative;
    overflow: hidden;
    border-radius: 0.9rem;
    background: var(--card);
  }

  /* The centre tile plays the part the iOS wordmark plays on the slide. */
  .vn-bento__tile--hero {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    background: radial-gradient(120% 120% at 30% 10%, #3a1f2b 0%, var(--card) 70%);
  }

  .vn-bento__tile--hero img {
    width: clamp(3.5rem, 7vw, 5.5rem);
    height: auto;
    border-radius: 22%;
  }

  .vn-bento__tile--hero p {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Artwork centred in the free space, caption underneath: the caption keeps
     the same size on every tile, as on the slide. */
  .vn-bento__tile--art {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
  }

  /* auto margins let the artwork claim the free space and centre in it, which
     pins the caption to the bottom edge whatever the tile height. Absolutely
     positioned backdrops are out of flow, so the rule skips over them. */
  .vn-bento__tile--art > :not(.vn-bento__label) {
    margin: auto;
  }

  .vn-bento__label {
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--text);
  }

  .vn-siri {
    width: min(88%, 5.5rem);
    height: auto;
  }

  .vn-heart {
    width: min(60%, 3.4rem);
    height: auto;
    color: #ff3b30;
  }

  .vn-heart path {
    fill: currentColor;
  }

  .vn-people {
    position: relative;
    width: 7rem;
    aspect-ratio: 1;
  }

  /* Overlapping discs, the way the app shows a shared cellar's members. The
     ring is the tile colour so they read as a stack rather than a row. */
  .vn-bubble {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    translate: calc(-50% + var(--x)) calc(-50% + var(--y));
    border-radius: 999px;
    background: var(--tone);
    overflow: hidden;
  }

  /* Inset so the face never touches the rim. */
  .vn-bubble img {
    width: 74%;
    height: auto;
  }

  .vn-glyph {
    width: min(52%, 4rem);
    height: auto;
  }

  /* Caption on top, device below and deliberately taller than the space left,
     so it runs off the bottom edge the way the keynote slide crops a phone. */
  .vn-bento__tile--head {
    position: relative;
    overflow: hidden;
    /* No padding on the tile itself: the caption and the device each carry
       their own inset, so the device can be positioned freely. */
    padding: 0;
    /* Makes the tile a query container so the frame can size itself against it
       in a real length. */
    container-type: inline-size;
  }

  .vn-bento__tile--head .vn-bento__label {
    padding: 1rem 0.75rem 0;
  }

  /* --iphone-w feeds calc() for the bezel and the corner radii, so it has to be
     a length: a percentage would resolve against the parent and warp the frame.
     Doubled class so it outranks .iphone's own width. */
  :global(.iphone.vn-bento__phone) {
    --iphone-w: 87cqw;
    position: absolute;
    top: 5rem;
    left: 50%;
    translate: -50% 0;
  }

  /* Centred, and left to run off the bottom edge. */
  :global(.iphone.vn-bento__phone--corner) {
    --iphone-w: 89cqw;
    top: auto;
    bottom: -5.4rem;
  }

  /* The screenshot carries its own status bar and island. */
  :global(.vn-bento__phone) :global(.iphone__island) {
    display: none;
  }

  /* A rising curve behind the glyph, bled to the tile edges. */
  .vn-trend {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .vn-trend__area {
    fill: color-mix(in srgb, var(--accent) 13%, transparent);
  }

  .vn-trend__line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    /* preserveAspectRatio="none" stretches the stroke too; this keeps it even. */
    vector-effect: non-scaling-stroke;
  }

  /* The export file itself as the artwork, bled to the tile edges and faded
     back so it reads as texture rather than as something to be read. It fades
     out above the caption, which keeps a clean background to sit on. */
  .vn-json {
    position: absolute;
    inset: 0;
    padding: 0.75rem 0.6rem 0;
    overflow: hidden;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5rem;
    line-height: 1.7;
    white-space: pre;
    color: var(--accent);
    opacity: 0.45;
    mask-image: linear-gradient(to bottom, #000 52%, transparent 86%);
  }

  /* The code is out of flow, so nothing pushes the caption down the way the
     artwork does on the other tiles: it claims the free space itself. */
  .vn-json + .vn-bento__label {
    margin-top: auto;
  }

  .vn-quote {
    width: min(52%, 3rem);
    height: auto;
    fill: var(--text);
  }

  .vn-price {
    position: relative;
    color: var(--accent);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .vn-stars {
    display: flex;
    gap: 0.15rem;
  }

  .vn-stars svg {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--accent);
  }

  .vn-stars svg path {
    fill: currentColor;
  }

  /* The rows already carry their own inset, so the tile gives them the width
     back: at this size every pixel counts for the wine names. No bottom padding,
     because the list is meant to reach the edge and be cut by it. */
  .vn-bento__tile--rows {
    padding: 0.7rem 0.55rem 0;
  }

  .vn-ready {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    width: 100%;
    padding: 0;
    list-style: none;
  }

  /* Pinned under the title rather than centred in the free space: the overflow
     has to fall past the bottom edge, where the tile clips it, the way the
     keynote slide crops a phone. */
  .vn-bento__tile--rows .vn-ready {
    margin: 1.55rem 0 0;
  }

  .vn-ready__row {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    border-radius: 0.5rem;
    padding: 0.28rem 0.4rem;
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }

  .vn-ready__dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--dot);
  }

  /* Long producer names get cut the way the app cuts them, rather than wrapping
     the row onto a second line. */
  .vn-ready__name {
    flex: 1;
    min-width: 0;
    font-size: 0.65rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The app's amber deadline pill. Hard-coded rather than themed: it means
     "drink it soon" in the app, and the accent gold would lose that. */
  .vn-ready__badge {
    flex: none;
    border-radius: 999px;
    padding: 0.12rem 0.4rem;
    background: #e08b3c;
    color: #21150a;
    font-size: 0.5625rem;
    font-weight: 650;
    white-space: nowrap;
  }

  /* Edge to edge artwork: the image covers the tile and the caption rides on
     top of it, over a scrim so it stays readable whatever the image shows. */
  .vn-bento__tile--fill {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 0;
  }

  .vn-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Anchored high so the crystal stopper stays in frame; the crop eats the
     base instead, which carries less of the shape. */
  /* Anchored to the top so the cork stays in frame; the base runs past the
     bottom edge, where the tile clips it. */
  .vn-map--sake {
    inset: 0.25rem auto auto 50%;
    translate: -50% 0;
    width: 69%;
    height: auto;
    object-fit: contain;
  }

  .vn-map--decanter {
    object-position: 50% 4%;
    /* The crop cut the base off with a hard edge; this dissolves it into the
       tile instead. */
    mask-image: linear-gradient(to bottom, #000 62%, transparent 96%);
  }

  .vn-bento__tile--fill .vn-bento__label {
    position: relative;
    padding: 2.5rem 0.75rem 0.9rem;
    background: linear-gradient(to top, rgba(10, 6, 8, 0.85) 35%, transparent);
  }

  /* ---------- How it works ---------- */
  :global(.vn-steps) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .vn-step {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .vn-step__n {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .vn-duo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 4vw, 3rem);
    margin-top: 4rem;
  }

  :global(.vn-duo__arrow) span {
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: var(--accent);
  }

  /* ---------- Pricing ---------- */
  /* Like the two sections before it, this one leans on the previous section's
     bottom padding: its own on top would double the gap. */
  .vn-pricing {
    padding-top: 0;
  }

  /* A comparison table rather than two cards: with a single line differing
     between the plans, the rows say more side by side than in two lists.
     Separate borders, not collapsed, so the premium column can be rounded. */
  .vn-plans {
    width: 100%;
    margin-top: 2.5rem;
    border-collapse: separate;
    border-spacing: 0;
    text-align: left;
  }

  .vn-plans th,
  .vn-plans td {
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .vn-plans thead th {
    vertical-align: bottom;
    border-bottom-color: color-mix(in srgb, var(--text) 22%, transparent);
    padding-bottom: 1.1rem;
  }

  .vn-plans tbody tr:last-child th,
  .vn-plans tbody tr:last-child td {
    border-bottom: 0;
  }

  .vn-plans tbody th {
    font-weight: 450;
    font-size: 0.9375rem;
    color: var(--text);
  }

  /* The two plan columns are narrow and equal: the feature names take the rest
     and are the only thing that wraps. */
  .vn-plans th:not(:first-child),
  .vn-plans td {
    width: 22%;
    text-align: center;
  }

  .vn-plans td {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .vn-plans__name {
    display: block;
    font-size: 1.15rem;
    font-weight: 600;
  }

  /* A price broken across two lines reads as two prices: both figures keep
     their period glued to them, whatever the column width. */
  .vn-plans__price,
  .vn-plans__alt {
    white-space: nowrap;
  }

  .vn-plans__price {
    display: block;
    margin-top: 0.2rem;
    color: var(--accent);
    font-weight: 650;
  }

  /* The yearly plan, quoted under the monthly one: the saving reads by itself
     from the two figures, no badge needed. */
  .vn-plans__alt {
    display: block;
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .vn-plans__options {
    display: block;
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
  }

  /* One tinted band running the height of the table, the way the premium card
     used to stand out from the free one. */
  .vn-plans__premium {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .vn-plans thead .vn-plans__premium {
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .vn-plans tbody tr:last-child .vn-plans__premium {
    border-radius: 0 0 var(--radius-card) var(--radius-card);
  }

  .vn-plans__check {
    color: var(--accent);
    font-weight: 700;
  }

  /* Screen-reader-only text: the ticks and the section heading both show
     nothing visually but must read as words. */
  .vn-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .vn-pricing__options-mobile {
    display: none;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  :global(.vn-pricing__cta-wrap) {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .vn-nav__links {
      display: none;
    }

    /* Tighter gutters and shorter section breaks: on a phone the page is one
       long column, so the space the desktop layout spends on air is better
       spent on the content itself. */
    .container {
      width: min(var(--container), 100% - 2rem);
    }

    .section {
      padding-block: clamp(3rem, 7vh, 4.5rem);
    }

    /* Balancing buys even line lengths at the cost of width, which on a phone
       leaves a third of the column empty and pushes a two-line title onto
       three. Narrow enough here that filling the measure reads better. */
    .vn-display,
    .vn-headline {
      text-wrap: pretty;
    }

    /* Flex sizes the title's text to its longest word, so "Plus qu'un
       gestionnaire de cave" sat in a 182px column inside a 327px one. Block
       layout lets the text fill the measure. */
    .vn-headline--icon {
      display: block;
    }

    /* The glyph costs a word's worth of the first line for decoration only:
       the titles read better using the whole measure. */
    .vn-headline--icon svg {
      display: none;
    }

    .vn-duo {
      gap: clamp(0.5rem, 2.5vw, 1.5rem);
    }

    .vn-duo :global(.iphone) {
      --iphone-w: clamp(120px, 36vw, 240px);
    }

    .vn-hero__inner,
    .vn-cellars__inner,
    .vn-search__inner {
      grid-template-columns: 1fr;
    }

    /* Stacked under the finder, the cellar screenshot only pushed the rest of
       the page down: the section is about the catalogue, and the hero video
       already shows the app. */
    :global(.vn-cellars__phone) {
      display: none;
    }

    :global(.vn-finder) {
      margin-top: 1.25rem;
    }

    .vn-finder__panel {
      padding: 1rem;
    }


    .vn-bento__title {
      margin-bottom: 1.5rem;
    }

    .vn-search__fields {
      margin-top: 1.25rem;
    }

    .vn-search__sub {
      margin-top: 1.5rem;
    }

    .vn-plans {
      margin-top: 1.5rem;
    }

    :global(.vn-pricing__cta-wrap) {
      margin-top: 2rem;
    }

    /* The 15-column mosaic is unreadable on a phone: fall back to a plain
       two-column grid and let the tiles take their natural order. */
    .vn-bento {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: none;
      grid-auto-rows: 7rem;
      /* The one tile that spans both columns cannot start mid-row, so it would
         leave a hole behind it; dense packing backfills it with the next tile. */
      grid-auto-flow: dense;
      aspect-ratio: auto;
    }

    .vn-bento__tile {
      grid-area: auto !important;
    }

    /* Half a phone width leaves the wine names about seven characters, which is
       no list at all: this tile takes the full width and two rows instead. */
    .vn-bento__tile--rows {
      grid-column: span 2 !important;
      grid-row: span 2 !important;
    }

    :global(.vn-hero__phone) {
      margin-top: 1rem;
    }

    :global(.vn-steps) {
      grid-template-columns: 1fr;
    }

    .vn-plans th,
    .vn-plans td {
      padding: 0.7rem 0.5rem;
    }

    /* A tick needs no quarter of the width: the plan columns shrink to their
       content so the feature names stop wrapping onto three lines. */
    .vn-plans th:not(:first-child),
    .vn-plans td {
      width: 4rem;
    }

    .vn-plans tbody th,
    .vn-plans td {
      font-size: 0.8125rem;
    }

    .vn-plans__name {
      font-size: 1rem;
    }

    /* "Abonnement" is one unbreakable word and sets the column's minimum width,
       so it is what has to give for the feature names to fit. */
    .vn-plans__price {
      font-size: 0.8125rem;
    }

    /* Too narrow a column to carry a sentence: the two subscription options
       move under the table, next to the note. */
    .vn-plans__options {
      display: none;
    }

    .vn-pricing__options-mobile {
      display: block;
    }
  }
</style>

<script>
  import { initBento } from '../../scripts/bento'
  import { initCellarFinder } from '../../scripts/cellar-finder'
  import { initSearchDemo } from '../../scripts/search-demo'
  import { initPriceTrend } from '../../scripts/price-trend'
  import { prefersReducedMotion } from '../../scripts/motion'
  import { initScreenSwap } from '../../scripts/screen-swap'

  initBento()
  initCellarFinder()
  initSearchDemo()
  initPriceTrend()
  initScreenSwap()

  if (prefersReducedMotion()) {
    for (const video of document.querySelectorAll<HTMLVideoElement>('.vn-hero__video')) {
      video.removeAttribute('autoplay')
      video.pause()
    }
  }
</script>
