  }

  .vn-finder__field input:focus {
    outline: none;
  }

  .vn-finder__field input::-webkit-search-cancel-button {
    filter: invert(1);
    opacity: 0.5;
  }

  .vn-finder__count {
    margin: 1rem 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 550;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .vn-finder__count span {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  /* Fixed height, so filtering down to one result does not collapse the panel
     and shove the rest of the section around. */
  .vn-finder__results {
    position: relative;
    height: 22rem;
  }

  /* The whole catalogue ships in the HTML, so the list scrolls rather than
     stretching the page to 148 rows. */
  .vn-finder__list {
    height: 100%;
    overflow-y: auto;
    margin: 0;
    padding: 0;
    list-style: none;
    overscroll-behavior: contain;
  }

  .vn-finder__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    padding: 0.6rem 0.2rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .vn-finder__item[hidden] {
    display: none;
  }

  /* No rule under the last row. The DOM last covers the unfiltered list; the
     script tags the last *visible* row once a search hides part of it. */
  .vn-finder__item:last-child,
  .vn-finder__item[data-last] {
    border-bottom: 0;
  }

  .vn-finder__brand {
    grid-column: 1;
    font-weight: 650;
  }

  .vn-finder__model {
    grid-column: 1;
    grid-row: 2;
    color: var(--muted);
  }

  .vn-finder__spec {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .vn-finder__empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .vn-finder__empty[hidden] {
    display: none;
  }

  /* The catalogue scrolls inside a page that also scrolls, and it takes up most
     of the screen on a phone: a swipe or a wheel over it moved the list instead
     of the page, with no way to get past the section. It stays locked until it
     is picked, which lets the gesture through to the page. Only the script sets
     the attribute, so without JavaScript the list keeps its native scrolling. */
  [data-cellar-results][data-gate='closed'] .vn-finder__list {
    overflow-y: hidden;
  }

  /* The prompt shows in the locked state alone: once the list scrolls, its own
     movement says so. */
  .vn-finder__gate {
    display: none;
  }

  [data-cellar-results][data-gate='closed'] .vn-finder__gate {
    display: block;
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    /* Deep top padding so the gradient has room to fade the cut-off rows out
       behind the label rather than ending on a hard edge. */
    padding: 2.75rem 0 0.6rem;
    background: linear-gradient(to top, var(--card) 55%, transparent);
    text-align: center;
    font-size: 0.75rem;
    font-weight: 550;
    color: var(--muted);
    /* The click has to reach the list underneath: it is what opens the gate. */
    pointer-events: none;
  }

  /* Nothing to scroll: a filtered list that fits, or no result at all. */
  [data-cellar-results][data-gate='closed'] .vn-finder__gate[hidden] {
    display: none;
  }

  /* ---------- Global search ---------- */
  /* The bento above already carries its own bottom gap; a second one here left
     a hole once the story section went. */
  #search {
