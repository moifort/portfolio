  @keyframes vn-caret {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vn-searchbar__typed::after {
      animation: none;
    }
  }

  /* Two columns so the ten fields read as a set rather than a long scroll. */
  .vn-search__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
